 "font_size": 13,
 "html": "<style>\n{{ font_css() }}\n.th-doc, .th-doc * { font-family: 'Sarabun', sans-serif !important; color: #111; }\n.th-doc { font-size: 13px; line-height: 1.45; }\n.th-doc table { width: 100%; border-collapse: collapse; }\n.th-head td { vertical-align: top; }\n.th-title { text-align: right; }\n.th-title h1 { font-size: 22px; font-weight: 700; margin: 0; }\n.th-title .copy { font-size: 12px; border: 1px solid #111; display: inline-block; padding: 1px 10px; margin-bottom: 6px; }\n.th-company { font-size: 16px; font-weight: 700; }\n.th-box { border: 1px solid #111; padding: 8px 10px; }\n.th-parties td { width: 50%; vertical-align: top; }\n.th-items { margin-top: 10px; }\n.th-items th { border: 1px solid #111; background: #f2f2f2; padding: 5px; font-weight: 700; text-align: center; }\n.th-items td { border-left: 1px solid #111; border-right: 1px solid #111; padding: 4px 6px; }\n.th-items tr.last td { border-bottom: 1px solid #111; }\n.num { text-align: right; white-space: nowrap; }\n.center { text-align: center; }\n.th-totals td { padding: 3px 6px; }\n.th-totals .tl { text-align: right; }\n.th-words { border: 1px solid #111; background: #f7f7f7; padding: 6px 10px; font-weight: 700; }\n.th-sign td { width: 50%; text-align: center; padding-top: 50px; }\n.muted { color: #555; font-size: 12px; }\n</style>\n\n{% set customer_branch = frappe.db.get_value(\"Customer\", doc.customer, \"thai_branch_code\") %}\n{% set company_tax_id = frappe.db.get_value(\"Company\", doc.company, \"tax_id\") %}\n{% set company_branch = frappe.db.get_value(\"Company\", doc.company, \"thai_branch_code\") %}\n{% set vat = doc.total_taxes_and_charges or 0 %}\n\n<div class=\"th-doc\">\n\t<table class=\"th-head\">\n\t\t<tr>\n\t\t\t<td style=\"width: 60%\">\n\t\t\t\t<div class=\"th-company\">{{ doc.company }}</div>\n\t\t\t\t<div>{{ company_address(doc.company) }}</div>\n\t\t\t\t<div>\u0e40\u0e25\u0e02\u0e1b\u0e23\u0e30\u0e08\u0e33\u0e15\u0e31\u0e27\u0e1c\u0e39\u0e49\u0e40\u0e2a\u0e35\u0e22\u0e20\u0e32\u0e29\u0e35\u0e2d\u0e32\u0e01\u0e23 {{ format_tax_id(company_tax_id) }} &nbsp; ({{ branch_label(company_branch) }})</div>\n\t\t\t</td>\n\t\t\t<td class=\"th-title\">\n\t\t\t\t<div class=\"copy\">{{ \"\u0e2a\u0e33\u0e40\u0e19\u0e32\" if doc.is_return else \"\u0e15\u0e49\u0e19\u0e09\u0e1a\u0e31\u0e1a\" }}</div>\n\t\t\t\t<h1>\u0e43\u0e1a\u0e01\u0e33\u0e01\u0e31\u0e1a\u0e20\u0e32\u0e29\u0e35 / \u0e43\u0e1a\u0e41\u0e08\u0e49\u0e07\u0e2b\u0e19\u0e35\u0e49</h1>\n\t\t\t\t<div class=\"muted\">TAX INVOICE / INVOICE</div>\n\t\t\t</td>\n\t\t</tr>\n\t</table>\n\n\t<table class=\"th-parties\" style=\"margin-top: 10px\">\n\t\t<tr>\n\t\t\t<td class=\"th-box\">\n\t\t\t\t<b>\u0e25\u0e39\u0e01\u0e04\u0e49\u0e32</b> {{ doc.customer_name }}<br>\n\t\t\t\t{{ (doc.address_display or \"\") | replace(\"<br>\", \" \") | striptags }}<br>\n\t\t\t\t\u0e40\u0e25\u0e02\u0e1b\u0e23\u0e30\u0e08\u0e33\u0e15\u0e31\u0e27\u0e1c\u0e39\u0e49\u0e40\u0e2a\u0e35\u0e22\u0e20\u0e32\u0e29\u0e35\u0e2d\u0e32\u0e01\u0e23 {{ format_tax_id(doc.tax_id) or \"-\" }}\n\t\t\t\t&nbsp; ({{ branch_label(customer_branch) }})\n\t\t\t</td>\n\t\t\t<td class=\"th-box\">\n\t\t\t\t<table>\n\t\t\t\t\t<tr><td>\u0e40\u0e25\u0e02\u0e17\u0e35\u0e48</td><td class=\"num\"><b>{{ doc.name }}</b></td></tr>\n\t\t\t\t\t<tr><td>\u0e27\u0e31\u0e19\u0e17\u0e35\u0e48</td><td class=\"num\">{{ thai_date(doc.posting_date) }}</td></tr>\n\t\t\t\t\t{% if doc.due_date %}<tr><td>\u0e04\u0e23\u0e1a\u0e01\u0e33\u0e2b\u0e19\u0e14\u0e0a\u0e33\u0e23\u0e30</td><td class=\"num\">{{ thai_date(doc.due_date) }}</td></tr>{% endif %}\n\t\t\t\t\t{% if doc.po_no %}<tr><td>\u0e2d\u0e49\u0e32\u0e07\u0e2d\u0e34\u0e07\u0e43\u0e1a\u0e2a\u0e31\u0e48\u0e07\u0e0b\u0e37\u0e49\u0e2d</td><td class=\"num\">{{ doc.po_no }}</td></tr>{% endif %}\n\t\t\t\t</table>\n\t\t\t</td>\n\t\t</tr>\n\t</table>\n\n\t<table class=\"th-items\">\n\t\t<thead>\n\t\t\t<tr>\n\t\t\t\t<th style=\"width: 6%\">\u0e25\u0e33\u0e14\u0e31\u0e1a</th>\n\t\t\t\t<th>\u0e23\u0e32\u0e22\u0e01\u0e32\u0e23</th>\n\t\t\t\t<th style=\"width: 11%\">\u0e08\u0e33\u0e19\u0e27\u0e19</th>\n\t\t\t\t<th style=\"width: 9%\">\u0e2b\u0e19\u0e48\u0e27\u0e22</th>\n\t\t\t\t<th style=\"width: 14%\">\u0e23\u0e32\u0e04\u0e32\u0e15\u0e48\u0e2d\u0e2b\u0e19\u0e48\u0e27\u0e22</th>\n\t\t\t\t<th style=\"width: 16%\">\u0e08\u0e33\u0e19\u0e27\u0e19\u0e40\u0e07\u0e34\u0e19</th>\n\t\t\t</tr>\n\t\t</thead>\n\t\t<tbody>\n\t\t\t{% for item in doc.items %}\n\t\t\t<tr class=\"{{ 'last' if loop.last else '' }}\">\n\t\t\t\t<td class=\"center\">{{ loop.index }}</td>\n\t\t\t\t<td>{{ item.item_name }}{% if item.description and item.description | striptags != item.item_name %}<br><span class=\"muted\">{{ item.description | striptags }}</span>{% endif %}</td>\n\t\t\t\t<td class=\"num\">{{ frappe.utils.fmt_money(item.qty, precision=2) }}</td>\n\t\t\t\t<td class=\"center\">{{ item.uom }}</td>\n\t\t\t\t<td class=\"num\">{{ frappe.utils.fmt_money(item.rate, precision=2) }}</td>\n\t\t\t\t<td class=\"num\">{{ frappe.utils.fmt_money(item.amount, precision=2) }}</td>\n\t\t\t</tr>\n\t\t\t{% endfor %}\n\t\t</tbody>\n\t</table>\n\n\t<table class=\"th-totals\" style=\"margin-top: 6px\">\n\t\t<tr>\n\t\t\t<td rowspan=\"5\" style=\"width: 55%; vertical-align: top\">\n\t\t\t\t{% if doc.terms %}<div class=\"muted\">{{ doc.terms | striptags | truncate(400) }}</div>{% endif %}\n\t\t\t\t{% if doc.currency != \"THB\" %}\n\t\t\t\t<div class=\"muted\">\u0e2a\u0e01\u0e38\u0e25\u0e40\u0e07\u0e34\u0e19 {{ doc.currency }} \u0e2d\u0e31\u0e15\u0e23\u0e32\u0e41\u0e25\u0e01\u0e40\u0e1b\u0e25\u0e35\u0e48\u0e22\u0e19 1 {{ doc.currency }} = {{ doc.conversion_rate }} \u0e1a\u0e32\u0e17</div>\n\t\t\t\t{% endif %}\n\t\t\t</td>\n\t\t\t<td class=\"tl\">\u0e23\u0e27\u0e21\u0e40\u0e07\u0e34\u0e19</td>\n\t\t\t<td class=\"num\" style=\"width: 16%\">{{ frappe.utils.fmt_money(doc.total, precision=2) }}</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td class=\"tl\">\u0e2a\u0e48\u0e27\u0e19\u0e25\u0e14</td>\n\t\t\t<td class=\"num\">{{ frappe.utils.fmt_money(doc.discount_amount or 0, precision=2) }}</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td class=\"tl\">\u0e21\u0e39\u0e25\u0e04\u0e48\u0e32\u0e2a\u0e34\u0e19\u0e04\u0e49\u0e32\u0e2b\u0e23\u0e37\u0e2d\u0e1a\u0e23\u0e34\u0e01\u0e32\u0e23</td>\n\t\t\t<td class=\"num\">{{ frappe.utils.fmt_money(doc.net_total, precision=2) }}</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td class=\"tl\">\u0e20\u0e32\u0e29\u0e35\u0e21\u0e39\u0e25\u0e04\u0e48\u0e32\u0e40\u0e1e\u0e34\u0e48\u0e21{% for t in doc.taxes if t.rate %} {{ t.rate | int }}%{% endfor %}</td>\n\t\t\t<td class=\"num\">{{ frappe.utils.fmt_money(vat, precision=2) }}</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td class=\"tl\"><b>\u0e08\u0e33\u0e19\u0e27\u0e19\u0e40\u0e07\u0e34\u0e19\u0e23\u0e27\u0e21\u0e17\u0e31\u0e49\u0e07\u0e2a\u0e34\u0e49\u0e19</b></td>\n\t\t\t<td class=\"num\"><b>{{ frappe.utils.fmt_money(doc.grand_total, precision=2) }}</b></td>\n\t\t</tr>\n\t</table>\n\n\t<div class=\"th-words\" style=\"margin-top: 6px\">({{ bahttext(doc.grand_total if doc.currency == \"THB\" else doc.base_grand_total) }})</div>\n\n\t<table class=\"th-sign\">\n\t\t<tr>\n\t\t\t<td>.................................................<br>\u0e1c\u0e39\u0e49\u0e23\u0e31\u0e1a\u0e2a\u0e34\u0e19\u0e04\u0e49\u0e32 / \u0e1a\u0e23\u0e34\u0e01\u0e32\u0e23<br>\u0e27\u0e31\u0e19\u0e17\u0e35\u0e48 ......../......../........</td>\n\t\t\t<td>.................................................<br>\u0e1c\u0e39\u0e49\u0e21\u0e35\u0e2d\u0e33\u0e19\u0e32\u0e08\u0e25\u0e07\u0e19\u0e32\u0e21<br>\u0e43\u0e19\u0e19\u0e32\u0e21 {{ doc.company }}</td>\n\t\t</tr>\n\t</table>\n</div>\n",
