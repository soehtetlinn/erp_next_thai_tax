 "font_size": 13,
 "html": "<style>\n{{ font_css() }}\n.tw, .tw * { font-family: 'Sarabun', sans-serif !important; color: #111; }\n.tw { font-size: 11px; line-height: 1.3; }\n.tw table { width: 100%; border-collapse: collapse; }\n.tw .frame { border: 1.5px solid #111; padding: 8px 10px; }\n.tw .copy { text-align: right; font-size: 10px; }\n.tw h1 { text-align: center; font-size: 16px; font-weight: 700; margin: 0; }\n.tw .sub { text-align: center; margin-bottom: 5px; }\n.tw .party { border: 1px solid #111; padding: 4px 7px; margin-bottom: 5px; }\n.tw .party .role { font-weight: 700; }\n.tw .forms span { display: inline-block; margin-right: 14px; }\n.tw .box { display: inline-block; width: 11px; height: 11px; border: 1px solid #111; vertical-align: -1px; margin-right: 3px; text-align: center; line-height: 10px; font-size: 10px; }\n.tw .income th, .tw .income td { border: 1px solid #111; padding: 2px 5px; }\n.tw .income th { background: #f2f2f2; text-align: center; font-weight: 700; }\n.tw .num { text-align: right; white-space: nowrap; }\n.tw .center { text-align: center; }\n.tw .words { border: 1px solid #111; border-top: 0; padding: 5px 8px; font-weight: 700; background: #f7f7f7; }\n.tw .sign { margin-top: 10px; }\n.tw .sign td { vertical-align: top; }\n.tw .warn { font-size: 9.5px; border: 1px solid #111; padding: 4px; width: 40%; }\n.tw .seal { width: 56px; height: 56px; border: 1px dashed #777; border-radius: 50%; margin: 0 auto; text-align: center; font-size: 9px; color: #777; line-height: 56px; }\n</style>\n\n{% set company_tax_id = frappe.db.get_value(\"Company\", doc.company, \"tax_id\") %}\n{% set company_branch = frappe.db.get_value(\"Company\", doc.company, \"thai_branch_code\") %}\n{% set categories = {\n\t\"40(1)\": \"1. \u0e40\u0e07\u0e34\u0e19\u0e40\u0e14\u0e37\u0e2d\u0e19 \u0e04\u0e48\u0e32\u0e08\u0e49\u0e32\u0e07 \u0e40\u0e1a\u0e35\u0e49\u0e22\u0e40\u0e25\u0e35\u0e49\u0e22\u0e07 \u0e42\u0e1a\u0e19\u0e31\u0e2a \u0e2f\u0e25\u0e2f \u0e15\u0e32\u0e21\u0e21\u0e32\u0e15\u0e23\u0e32 40 (1)\",\n\t\"40(2)\": \"2. \u0e04\u0e48\u0e32\u0e18\u0e23\u0e23\u0e21\u0e40\u0e19\u0e35\u0e22\u0e21 \u0e04\u0e48\u0e32\u0e19\u0e32\u0e22\u0e2b\u0e19\u0e49\u0e32 \u0e2f\u0e25\u0e2f \u0e15\u0e32\u0e21\u0e21\u0e32\u0e15\u0e23\u0e32 40 (2)\",\n\t\"40(3)\": \"3. \u0e04\u0e48\u0e32\u0e41\u0e2b\u0e48\u0e07\u0e25\u0e34\u0e02\u0e2a\u0e34\u0e17\u0e18\u0e34\u0e4c \u0e2f\u0e25\u0e2f \u0e15\u0e32\u0e21\u0e21\u0e32\u0e15\u0e23\u0e32 40 (3)\",\n\t\"40(4)(\u0e01)\": \"4. (\u0e01) \u0e14\u0e2d\u0e01\u0e40\u0e1a\u0e35\u0e49\u0e22 \u0e2f\u0e25\u0e2f \u0e15\u0e32\u0e21\u0e21\u0e32\u0e15\u0e23\u0e32 40 (4) (\u0e01)\",\n\t\"40(4)(\u0e02)\": \"4. (\u0e02) \u0e40\u0e07\u0e34\u0e19\u0e1b\u0e31\u0e19\u0e1c\u0e25 \u0e40\u0e07\u0e34\u0e19\u0e2a\u0e48\u0e27\u0e19\u0e41\u0e1a\u0e48\u0e07\u0e01\u0e33\u0e44\u0e23 \u0e2f\u0e25\u0e2f \u0e15\u0e32\u0e21\u0e21\u0e32\u0e15\u0e23\u0e32 40 (4) (\u0e02)\",\n\t\"3 \u0e40\u0e15\u0e23\u0e2a\": \"5. \u0e01\u0e32\u0e23\u0e08\u0e48\u0e32\u0e22\u0e40\u0e07\u0e34\u0e19\u0e44\u0e14\u0e49\u0e17\u0e35\u0e48\u0e15\u0e49\u0e2d\u0e07\u0e2b\u0e31\u0e01\u0e20\u0e32\u0e29\u0e35 \u0e13 \u0e17\u0e35\u0e48\u0e08\u0e48\u0e32\u0e22 \u0e15\u0e32\u0e21\u0e04\u0e33\u0e2a\u0e31\u0e48\u0e07\u0e01\u0e23\u0e21\u0e2a\u0e23\u0e23\u0e1e\u0e32\u0e01\u0e23\u0e17\u0e35\u0e48\u0e2d\u0e2d\u0e01\u0e15\u0e32\u0e21\u0e21\u0e32\u0e15\u0e23\u0e32 3 \u0e40\u0e15\u0e23\u0e2a\",\n\t\"\u0e2d\u0e37\u0e48\u0e19 \u0e46\": \"6. \u0e2d\u0e37\u0e48\u0e19 \u0e46\",\n} %}\n{% set forms = [\"\u0e20.\u0e07.\u0e14.1\u0e01\", \"\u0e20.\u0e07.\u0e14.1\u0e01 \u0e1e\u0e34\u0e40\u0e28\u0e29\", \"\u0e20.\u0e07.\u0e14.2\", \"\u0e20.\u0e07.\u0e14.3\", \"\u0e20.\u0e07.\u0e14.2\u0e01\", \"\u0e20.\u0e07.\u0e14.3\u0e01\", \"\u0e20.\u0e07.\u0e14.53\"] %}\n{% set conditions = [\"\u0e2b\u0e31\u0e01 \u0e13 \u0e17\u0e35\u0e48\u0e08\u0e48\u0e32\u0e22\", \"\u0e2d\u0e2d\u0e01\u0e43\u0e2b\u0e49\u0e15\u0e25\u0e2d\u0e14\u0e44\u0e1b\", \"\u0e2d\u0e2d\u0e01\u0e43\u0e2b\u0e49\u0e04\u0e23\u0e31\u0e49\u0e07\u0e40\u0e14\u0e35\u0e22\u0e27\", \"\u0e2d\u0e37\u0e48\u0e19 \u0e46\"] %}\n\n{# Announcement No. 100: two identical copies for the payee, marked at the top #}\n{% for copy in [\"\u0e09\u0e1a\u0e31\u0e1a\u0e17\u0e35\u0e48 1 (\u0e2a\u0e33\u0e2b\u0e23\u0e31\u0e1a\u0e1c\u0e39\u0e49\u0e16\u0e39\u0e01\u0e2b\u0e31\u0e01\u0e20\u0e32\u0e29\u0e35 \u0e13 \u0e17\u0e35\u0e48\u0e08\u0e48\u0e32\u0e22 \u0e43\u0e0a\u0e49\u0e41\u0e19\u0e1a\u0e1e\u0e23\u0e49\u0e2d\u0e21\u0e01\u0e31\u0e1a\u0e41\u0e1a\u0e1a\u0e41\u0e2a\u0e14\u0e07\u0e23\u0e32\u0e22\u0e01\u0e32\u0e23\u0e20\u0e32\u0e29\u0e35)\",\n                \"\u0e09\u0e1a\u0e31\u0e1a\u0e17\u0e35\u0e48 2 (\u0e2a\u0e33\u0e2b\u0e23\u0e31\u0e1a\u0e1c\u0e39\u0e49\u0e16\u0e39\u0e01\u0e2b\u0e31\u0e01\u0e20\u0e32\u0e29\u0e35 \u0e13 \u0e17\u0e35\u0e48\u0e08\u0e48\u0e32\u0e22 \u0e40\u0e01\u0e47\u0e1a\u0e44\u0e27\u0e49\u0e40\u0e1b\u0e47\u0e19\u0e2b\u0e25\u0e31\u0e01\u0e10\u0e32\u0e19)\"] %}\n<div class=\"tw\" {% if not loop.last %}style=\"page-break-after: always\"{% endif %}>\n\t<div class=\"copy\">{{ copy }}</div>\n\t<div class=\"frame\">\n\t\t<table>\n\t\t\t<tr>\n\t\t\t\t<td style=\"width: 70%\"><h1>\u0e2b\u0e19\u0e31\u0e07\u0e2a\u0e37\u0e2d\u0e23\u0e31\u0e1a\u0e23\u0e2d\u0e07\u0e01\u0e32\u0e23\u0e2b\u0e31\u0e01\u0e20\u0e32\u0e29\u0e35 \u0e13 \u0e17\u0e35\u0e48\u0e08\u0e48\u0e32\u0e22</h1></td>\n\t\t\t\t<td class=\"num\">\u0e40\u0e25\u0e48\u0e21\u0e17\u0e35\u0e48 {{ doc.book_no or \"-\" }}<br>\u0e40\u0e25\u0e02\u0e17\u0e35\u0e48 <b>{{ doc.name }}</b></td>\n\t\t\t</tr>\n\t\t</table>\n\t\t<div class=\"sub\">\u0e15\u0e32\u0e21\u0e21\u0e32\u0e15\u0e23\u0e32 50 \u0e17\u0e27\u0e34 \u0e41\u0e2b\u0e48\u0e07\u0e1b\u0e23\u0e30\u0e21\u0e27\u0e25\u0e23\u0e31\u0e29\u0e0e\u0e32\u0e01\u0e23</div>\n\n\t\t<div class=\"party\">\n\t\t\t<span class=\"role\">\u0e1c\u0e39\u0e49\u0e21\u0e35\u0e2b\u0e19\u0e49\u0e32\u0e17\u0e35\u0e48\u0e2b\u0e31\u0e01\u0e20\u0e32\u0e29\u0e35 \u0e13 \u0e17\u0e35\u0e48\u0e08\u0e48\u0e32\u0e22 :</span>\n\t\t\t\u0e40\u0e25\u0e02\u0e1b\u0e23\u0e30\u0e08\u0e33\u0e15\u0e31\u0e27\u0e1c\u0e39\u0e49\u0e40\u0e2a\u0e35\u0e22\u0e20\u0e32\u0e29\u0e35\u0e2d\u0e32\u0e01\u0e23 <b>{{ format_tax_id(company_tax_id) }}</b> ({{ branch_label(company_branch) }})<br>\n\t\t\t\u0e0a\u0e37\u0e48\u0e2d <b>{{ doc.company }}</b><br>\n\t\t\t\u0e17\u0e35\u0e48\u0e2d\u0e22\u0e39\u0e48 {{ company_address(doc.company) }}\n\t\t</div>\n\n\t\t<div class=\"party\">\n\t\t\t<span class=\"role\">\u0e1c\u0e39\u0e49\u0e16\u0e39\u0e01\u0e2b\u0e31\u0e01\u0e20\u0e32\u0e29\u0e35 \u0e13 \u0e17\u0e35\u0e48\u0e08\u0e48\u0e32\u0e22 :</span>\n\t\t\t\u0e40\u0e25\u0e02\u0e1b\u0e23\u0e30\u0e08\u0e33\u0e15\u0e31\u0e27\u0e1c\u0e39\u0e49\u0e40\u0e2a\u0e35\u0e22\u0e20\u0e32\u0e29\u0e35\u0e2d\u0e32\u0e01\u0e23 <b>{{ format_tax_id(doc.payee_tax_id) }}</b> ({{ branch_label(doc.payee_branch) }})<br>\n\t\t\t\u0e0a\u0e37\u0e48\u0e2d <b>{{ doc.payee_name }}</b><br>\n\t\t\t\u0e17\u0e35\u0e48\u0e2d\u0e22\u0e39\u0e48 {{ (doc.payee_address or \"\") | replace(\"<br>\", \" \") | striptags }}\n\t\t\t<div class=\"forms\" style=\"margin-top: 4px\">\n\t\t\t\t\u0e25\u0e33\u0e14\u0e31\u0e1a\u0e17\u0e35\u0e48 ........ \u0e43\u0e19\u0e41\u0e1a\u0e1a\n\t\t\t\t{% for form in forms %}\n\t\t\t\t<span><span class=\"box\">{{ \"\u2713\" if doc.pnd_form == form else \"\" }}</span>({{ loop.index }}) {{ form }}</span>\n\t\t\t\t{% endfor %}\n\t\t\t</div>\n\t\t</div>\n\n\t\t<table class=\"income\">\n\t\t\t<thead>\n\t\t\t\t<tr>\n\t\t\t\t\t<th>\u0e1b\u0e23\u0e30\u0e40\u0e20\u0e17\u0e40\u0e07\u0e34\u0e19\u0e44\u0e14\u0e49\u0e1e\u0e36\u0e07\u0e1b\u0e23\u0e30\u0e40\u0e21\u0e34\u0e19\u0e17\u0e35\u0e48\u0e08\u0e48\u0e32\u0e22</th>\n\t\t\t\t\t<th style=\"width: 15%\">\u0e27\u0e31\u0e19 \u0e40\u0e14\u0e37\u0e2d\u0e19 \u0e2b\u0e23\u0e37\u0e2d\u0e1b\u0e35\u0e20\u0e32\u0e29\u0e35 \u0e17\u0e35\u0e48\u0e08\u0e48\u0e32\u0e22</th>\n\t\t\t\t\t<th style=\"width: 17%\">\u0e08\u0e33\u0e19\u0e27\u0e19\u0e40\u0e07\u0e34\u0e19\u0e17\u0e35\u0e48\u0e08\u0e48\u0e32\u0e22</th>\n\t\t\t\t\t<th style=\"width: 17%\">\u0e20\u0e32\u0e29\u0e35\u0e17\u0e35\u0e48\u0e2b\u0e31\u0e01 \u0e41\u0e25\u0e30\u0e19\u0e33\u0e2a\u0e48\u0e07\u0e44\u0e27\u0e49</th>\n\t\t\t\t</tr>\n\t\t\t</thead>\n\t\t\t<tbody>\n\t\t\t\t{% for code, label in categories.items() %}\n\t\t\t\t{% set rows = doc.items | selectattr(\"income_category\", \"equalto\", code) | list %}\n\t\t\t\t<tr>\n\t\t\t\t\t<td>{{ label }}{% for row in rows %}<br>&nbsp;&nbsp;&nbsp;- {{ row.description or \"\" }}{% if row.rate %} ({{ row.rate | round(2) }}%){% endif %}{% endfor %}</td>\n\t\t\t\t\t<td class=\"center\">{% for row in rows %}<br>{{ thai_date(row.paid_date or doc.posting_date, short=True) }}{% endfor %}</td>\n\t\t\t\t\t<td class=\"num\">{% for row in rows %}<br>{{ frappe.utils.fmt_money(row.amount, precision=2) }}{% endfor %}</td>\n\t\t\t\t\t<td class=\"num\">{% for row in rows %}<br>{{ frappe.utils.fmt_money(row.tax_amount, precision=2) }}{% endfor %}</td>\n\t\t\t\t</tr>\n\t\t\t\t{% endfor %}\n\t\t\t\t<tr>\n\t\t\t\t\t<td colspan=\"2\" class=\"num\"><b>\u0e23\u0e27\u0e21\u0e40\u0e07\u0e34\u0e19\u0e17\u0e35\u0e48\u0e08\u0e48\u0e32\u0e22\u0e41\u0e25\u0e30\u0e20\u0e32\u0e29\u0e35\u0e17\u0e35\u0e48\u0e2b\u0e31\u0e01\u0e19\u0e33\u0e2a\u0e48\u0e07</b></td>\n\t\t\t\t\t<td class=\"num\"><b>{{ frappe.utils.fmt_money(doc.total_amount, precision=2) }}</b></td>\n\t\t\t\t\t<td class=\"num\"><b>{{ frappe.utils.fmt_money(doc.total_tax, precision=2) }}</b></td>\n\t\t\t\t</tr>\n\t\t\t</tbody>\n\t\t</table>\n\t\t<div class=\"words\">\u0e23\u0e27\u0e21\u0e40\u0e07\u0e34\u0e19\u0e20\u0e32\u0e29\u0e35\u0e17\u0e35\u0e48\u0e2b\u0e31\u0e01\u0e19\u0e33\u0e2a\u0e48\u0e07 (\u0e15\u0e31\u0e27\u0e2d\u0e31\u0e01\u0e29\u0e23) &nbsp; ({{ bahttext(doc.total_tax) }})</div>\n\n\t\t<div style=\"margin-top: 6px\">\n\t\t\t\u0e40\u0e07\u0e34\u0e19\u0e17\u0e35\u0e48\u0e08\u0e48\u0e32\u0e22\u0e40\u0e02\u0e49\u0e32 \u0e01\u0e1a\u0e02./\u0e01\u0e2a\u0e08./\u0e01\u0e2d\u0e07\u0e17\u0e38\u0e19\u0e2a\u0e07\u0e40\u0e04\u0e23\u0e32\u0e30\u0e2b\u0e4c\u0e04\u0e23\u0e39\u0e42\u0e23\u0e07\u0e40\u0e23\u0e35\u0e22\u0e19\u0e40\u0e2d\u0e01\u0e0a\u0e19 ........ \u0e1a\u0e32\u0e17 &nbsp;\n\t\t\t\u0e01\u0e2d\u0e07\u0e17\u0e38\u0e19\u0e1b\u0e23\u0e30\u0e01\u0e31\u0e19\u0e2a\u0e31\u0e07\u0e04\u0e21 ........ \u0e1a\u0e32\u0e17 &nbsp; \u0e01\u0e2d\u0e07\u0e17\u0e38\u0e19\u0e2a\u0e33\u0e23\u0e2d\u0e07\u0e40\u0e25\u0e35\u0e49\u0e22\u0e07\u0e0a\u0e35\u0e1e ........ \u0e1a\u0e32\u0e17\n\t\t</div>\n\n\t\t<div style=\"margin-top: 6px\">\n\t\t\t<b>\u0e1c\u0e39\u0e49\u0e08\u0e48\u0e32\u0e22\u0e40\u0e07\u0e34\u0e19</b>\n\t\t\t{% for label in conditions %}\n\t\t\t&nbsp; <span class=\"box\">{{ \"\u2713\" if doc.condition and doc.condition[0] == (loop.index | string) else \"\" }}</span>({{ loop.index }}) {{ label }}\n\t\t\t{% endfor %}\n\t\t</div>\n\n\t\t<table class=\"sign\">\n\t\t\t<tr>\n\t\t\t\t<td class=\"warn\">\n\t\t\t\t\t<b>\u0e04\u0e33\u0e40\u0e15\u0e37\u0e2d\u0e19</b> \u0e1c\u0e39\u0e49\u0e21\u0e35\u0e2b\u0e19\u0e49\u0e32\u0e17\u0e35\u0e48\u0e2d\u0e2d\u0e01\u0e2b\u0e19\u0e31\u0e07\u0e2a\u0e37\u0e2d\u0e23\u0e31\u0e1a\u0e23\u0e2d\u0e07\u0e01\u0e32\u0e23\u0e2b\u0e31\u0e01\u0e20\u0e32\u0e29\u0e35 \u0e13 \u0e17\u0e35\u0e48\u0e08\u0e48\u0e32\u0e22 \u0e1d\u0e48\u0e32\u0e1d\u0e37\u0e19\u0e44\u0e21\u0e48\u0e1b\u0e0f\u0e34\u0e1a\u0e31\u0e15\u0e34\u0e15\u0e32\u0e21\u0e21\u0e32\u0e15\u0e23\u0e32 50 \u0e17\u0e27\u0e34\n\t\t\t\t\t\u0e41\u0e2b\u0e48\u0e07\u0e1b\u0e23\u0e30\u0e21\u0e27\u0e25\u0e23\u0e31\u0e29\u0e0e\u0e32\u0e01\u0e23 \u0e15\u0e49\u0e2d\u0e07\u0e23\u0e31\u0e1a\u0e42\u0e17\u0e29\u0e17\u0e32\u0e07\u0e2d\u0e32\u0e0d\u0e32\u0e15\u0e32\u0e21\u0e21\u0e32\u0e15\u0e23\u0e32 35 \u0e41\u0e2b\u0e48\u0e07\u0e1b\u0e23\u0e30\u0e21\u0e27\u0e25\u0e23\u0e31\u0e29\u0e0e\u0e32\u0e01\u0e23\n\t\t\t\t</td>\n\t\t\t\t<td class=\"center\">\n\t\t\t\t\t\u0e02\u0e2d\u0e23\u0e31\u0e1a\u0e23\u0e2d\u0e07\u0e27\u0e48\u0e32\u0e02\u0e49\u0e2d\u0e04\u0e27\u0e32\u0e21\u0e41\u0e25\u0e30\u0e15\u0e31\u0e27\u0e40\u0e25\u0e02\u0e14\u0e31\u0e07\u0e01\u0e25\u0e48\u0e32\u0e27\u0e02\u0e49\u0e32\u0e07\u0e15\u0e49\u0e19\u